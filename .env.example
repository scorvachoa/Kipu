# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud / Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev: http://localhost:3000/api/gmail/callback
# Producción (Vercel): https://TU-DOMINIO.vercel.app/api/gmail/callback
GOOGLE_REDIRECT_URI=

# Cifrado del refresh token de Gmail
GMAIL_TOKEN_ENCRYPTION_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# URL pública de la aplicación
# Dev: http://localhost:3000
# Producción (Vercel): https://TU-DOMINIO.vercel.app
NEXT_PUBLIC_APP_URL=

# Google AI (dashboard y Telegram; gemini-2.5-flash)
# Admite varias keys: GOOGLE_AI_API_KEY_1, GOOGLE_AI_API_KEY_2, ... para rotar
# y saltar automáticamente las que agotan su cuota (429).
# GOOGLE_AI_API_KEY_1=
# GOOGLE_AI_API_KEY_2=
# GOOGLE_AI_API_KEY_3=
GOOGLE_AI_MODEL=gemini-2.5-flash

# Proveedores de IA adicionales
# Orden de prioridad global (dashboard, Telegram, comandos):
# AI_PROVIDER_ORDER=gemini,groq,openrouter

# Pool para EMAILS (parseo y categorización): principal + respaldo.
# Por defecto excluye Gemini (no entrena con tus datos bancarios).
# Principal: Groq. Respaldo: OpenRouter.
# Email provider order (comma-separated):
EMAIL_AI_PROVIDER_ORDER=groq,openrouter
# Cada proveedor admite GROQ_API_KEY_1..N, OPENROUTER_API_KEY_1..N, etc.

# Groq (principal para emails: no entrena con tus datos)
# GROQ_API_KEY_1=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (respaldo para emails, modelos ":free")
# OPENROUTER_API_KEY_1=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free